{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/stellastoneandsteel/prepende/main/schemas/protocol-v2-row.schema.json",
  "title": "Prepende Protocol v2 row",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "seq", "prev_hash", "event_type", "event", "event_hash", "row_hash"],
  "properties": {
    "protocol": {"const": "prepende/2"},
    "seq": {"type": "integer", "minimum": 0},
    "prev_hash": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "event_type": {"enum": ["genesis", "legacy_import", "contract", "resolution", "forfeit", "void", "checkpoint", "anchor"]},
    "event_hash": {"$ref": "#/$defs/digest"},
    "row_hash": {"$ref": "#/$defs/digest"},
    "event": {
      "oneOf": [
        {"$ref": "#/$defs/genesis"},
        {"$ref": "#/$defs/legacy_import"},
        {"$ref": "#/$defs/contract"},
        {"$ref": "#/$defs/resolution"},
        {"$ref": "#/$defs/disposition"},
        {"$ref": "#/$defs/checkpoint"},
        {"$ref": "#/$defs/anchor"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "genesis"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/genesis"}}}},
    {"if": {"properties": {"event_type": {"const": "legacy_import"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/legacy_import"}}}},
    {"if": {"properties": {"event_type": {"const": "contract"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/contract"}}}},
    {"if": {"properties": {"event_type": {"const": "resolution"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/resolution"}}}},
    {"if": {"properties": {"event_type": {"const": "forfeit"}}}, "then": {"properties": {"event": {"allOf": [{"$ref": "#/$defs/disposition"}, {"properties": {"disposition": {"const": "forfeit"}}}]}}}},
    {"if": {"properties": {"event_type": {"const": "void"}}}, "then": {"properties": {"event": {"allOf": [{"$ref": "#/$defs/disposition"}, {"properties": {"disposition": {"const": "void"}}}]}}}},
    {"if": {"properties": {"event_type": {"const": "checkpoint"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/checkpoint"}}}},
    {"if": {"properties": {"event_type": {"const": "anchor"}}}, "then": {"properties": {"event": {"$ref": "#/$defs/anchor"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(?:0|-?[1-9][0-9]*|-?0\\.[0-9]*[1-9]|-?[1-9][0-9]*\\.[0-9]*[1-9])$"},
    "stream_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,199}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "genesis": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "stream_id", "registered_predictor", "anchor_policy", "created_at"],
      "properties": {
        "protocol": {"const": "prepende/2"}, "stream_id": {"$ref": "#/$defs/stream_id"},
        "registered_predictor": {"type": "string", "minLength": 1, "maxLength": 200}, "anchor_policy": {"enum": ["required", "optional"]},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "legacy_import": {
      "type": "object", "additionalProperties": false,
      "required": ["source_protocol", "source_digest", "source_bytes", "source_rows", "git_commit", "classification", "imported_at"],
      "properties": {
        "source_protocol": {"const": "prepende/1"}, "source_digest": {"$ref": "#/$defs/digest"},
        "source_bytes": {"type": "integer", "minimum": 0}, "source_rows": {"type": "integer", "minimum": 0},
        "git_commit": {"type": "string"}, "classification": {"const": "legacy-self-attested"},
        "imported_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "stream_id", "predictor", "model_version", "domain", "event_id", "question", "kind", "claim", "resolution_rule", "evaluator", "evaluation", "issued_at", "resolution_due_at", "resolver_policy", "nonresolution_policy", "void_policy", "provenance"],
      "properties": {
        "contract_id": {"$ref": "#/$defs/digest"}, "stream_id": {"$ref": "#/$defs/stream_id"}, "predictor": {"type": "string", "minLength": 1, "maxLength": 200},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 200}, "domain": {"type": "string", "minLength": 1, "maxLength": 200}, "event_id": {"type": "string", "minLength": 1, "maxLength": 500},
        "question": {"type": "string", "minLength": 1, "maxLength": 8000}, "kind": {"enum": ["probability", "numeric", "categorical"]},
        "claim": {"$ref": "#/$defs/claim"}, "resolution_rule": {"type": "string", "minLength": 1, "maxLength": 8000},
        "evaluator": {"$ref": "#/$defs/evaluator"}, "evaluation": {"$ref": "#/$defs/evaluation"},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "resolution_due_at": {"$ref": "#/$defs/timestamp"},
        "resolver_policy": {"$ref": "#/$defs/resolver_policy"}, "nonresolution_policy": {"$ref": "#/$defs/nonresolution_policy"},
        "void_policy": {"$ref": "#/$defs/void_policy"}, "provenance": {"enum": ["forward", "retrospective"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "probability"}}}, "then": {"properties": {"claim": {"$ref": "#/$defs/probability_claim"}, "evaluator": {"properties": {"type": {"enum": ["binary_value", "binary_threshold"]}}}, "nonresolution_policy": {"properties": {"metric": {"const": "brier"}}}}}},
        {"if": {"properties": {"kind": {"const": "numeric"}}}, "then": {"properties": {"claim": {"$ref": "#/$defs/numeric_claim"}, "evaluator": {"properties": {"type": {"const": "numeric_field"}}}, "nonresolution_policy": {"properties": {"metric": {"const": "absolute_error"}}}}}},
        {"if": {"properties": {"kind": {"const": "categorical"}}}, "then": {"properties": {"claim": {"$ref": "#/$defs/categorical_claim"}, "evaluator": {"properties": {"type": {"const": "categorical_field"}}}, "nonresolution_policy": {"properties": {"metric": {"const": "brier"}}}}}}
      ]
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution_id", "stream_id", "contract_id", "outcome", "evidence", "resolved_at", "resolver_key_id", "signature", "note"],
      "properties": {
        "resolution_id": {"$ref": "#/$defs/digest"}, "stream_id": {"$ref": "#/$defs/stream_id"},
        "contract_id": {"$ref": "#/$defs/digest"}, "outcome": {"$ref": "#/$defs/outcome"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "resolved_at": {"$ref": "#/$defs/timestamp"},
        "resolver_key_id": {"type": ["string", "null"]}, "signature": {"type": ["string", "null"]},
        "note": {"type": "string", "maxLength": 8000}
      }
    },
    "disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition_id", "stream_id", "contract_id", "disposition", "at", "reason_code", "note", "resolver_key_id", "signature"],
      "properties": {
        "disposition_id": {"$ref": "#/$defs/digest"}, "stream_id": {"$ref": "#/$defs/stream_id"},
        "contract_id": {"$ref": "#/$defs/digest"}, "disposition": {"enum": ["forfeit", "void"]},
        "at": {"$ref": "#/$defs/timestamp"}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 80}, "note": {"type": "string", "maxLength": 8000},
        "resolver_key_id": {"type": ["string", "null"]}, "signature": {"type": ["string", "null"]}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "stream_id", "covered_through", "covered_head", "row_count", "created_at"],
      "properties": {
        "checkpoint_id": {"$ref": "#/$defs/digest"}, "stream_id": {"$ref": "#/$defs/stream_id"},
        "covered_through": {"type": "integer", "minimum": 0}, "covered_head": {"$ref": "#/$defs/digest"},
        "row_count": {"type": "integer", "minimum": 1}, "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["anchor_id", "statement", "signature"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/digest"}, "statement": {"$ref": "#/$defs/anchor_statement"},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "probability_claim": {
      "type": "object", "additionalProperties": false, "required": ["p"],
      "properties": {"p": {"$ref": "#/$defs/decimal"}}
    },
    "numeric_claim": {
      "type": "object", "additionalProperties": false, "required": ["value", "lo", "hi", "unit"],
      "properties": {"value": {"$ref": "#/$defs/decimal"}, "lo": {"$ref": "#/$defs/decimal"}, "hi": {"$ref": "#/$defs/decimal"}, "unit": {"type": "string", "minLength": 1, "maxLength": 80}}
    },
    "categorical_claim": {
      "type": "object", "additionalProperties": false, "required": ["label", "p"],
      "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 500}, "p": {"$ref": "#/$defs/decimal"}}
    },
    "claim": {"oneOf": [{"$ref": "#/$defs/probability_claim"}, {"$ref": "#/$defs/numeric_claim"}, {"$ref": "#/$defs/categorical_claim"}]},
    "evaluator": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "version", "parameters"], "properties": {"type": {"enum": ["binary_value", "numeric_field", "categorical_field"]}, "version": {"const": "1"}, "parameters": {"$ref": "#/$defs/field_parameters"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "version", "parameters"], "properties": {"type": {"const": "binary_threshold"}, "version": {"const": "1"}, "parameters": {"$ref": "#/$defs/threshold_parameters"}}}
      ]
    },
    "field_parameters": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "field"],
      "properties": {"evidence": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}}
    },
    "threshold_parameters": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "field", "operator", "threshold"],
      "properties": {"evidence": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}, "operator": {"enum": [">", ">=", "<", "<=", "=="]}, "threshold": {"$ref": "#/$defs/decimal"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["role", "uri", "digest"],
      "properties": {"role": {"type": "string", "minLength": 1, "maxLength": 80}, "uri": {"type": "string", "minLength": 1, "maxLength": 1000}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["id", "spec_digest", "artifacts"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 200}, "spec_digest": {"$ref": "#/$defs/digest"}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}
    },
    "resolver_policy": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode", "authorized_key_ids"], "properties": {"mode": {"const": "self"}, "authorized_key_ids": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "authorized_key_ids"], "properties": {"mode": {"const": "signed"}, "authorized_key_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 200}}}}
      ]
    },
    "nonresolution_policy": {
      "type": "object", "additionalProperties": false, "required": ["action", "metric", "penalty"],
      "properties": {"action": {"const": "forfeit"}, "metric": {"enum": ["brier", "absolute_error"]}, "penalty": {"$ref": "#/$defs/decimal"}}
    },
    "void_policy": {
      "type": "object", "additionalProperties": false, "required": ["allowed_reason_codes"],
      "properties": {"allowed_reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}}}
    },
    "outcome": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["y"], "properties": {"y": {"type": "integer", "enum": [0, 1]}}},
        {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"$ref": "#/$defs/decimal"}}},
        {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string", "minLength": 1}}}
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["name", "uri", "digest", "content"],
      "properties": {"name": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "content": {}}
    },
    "anchor_statement": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "stream_id", "checkpoint_id", "checkpoint_row_hash", "covered_through", "covered_head", "row_count", "anchored_at", "key_id"],
      "properties": {"protocol": {"const": "prepende/2"}, "stream_id": {"$ref": "#/$defs/stream_id"}, "checkpoint_id": {"$ref": "#/$defs/digest"}, "checkpoint_row_hash": {"$ref": "#/$defs/digest"}, "covered_through": {"type": "integer", "minimum": 0}, "covered_head": {"$ref": "#/$defs/digest"}, "row_count": {"type": "integer", "minimum": 1}, "anchored_at": {"$ref": "#/$defs/timestamp"}, "key_id": {"type": "string", "minLength": 1}}
    }
  }
}

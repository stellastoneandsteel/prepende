# Prepende clean-clone environment. Create the private file with
# `install -m 600 .env.example .env`; never commit real values.

# Zero-cost first light. Select a real provider only after configuring its key.
MODEL_PROVIDER=echo
MODEL_NAME=
OPENAI_REASONING_EFFORT=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LOCAL_BASE_URL=http://localhost:11434/v1

# Lexical RAG is the safe zero-key default. Embeddings require explicit opt-in.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
# Optional local embeddings:
#   EMBEDDING_PROVIDER=local
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768

# Local first-light storage. Customer standup must use its own Postgres.
MEMORY_BACKEND=auto
DATABASE_URL=
WORKSPACE_ROOT=./.workspaces
MEMORY_SCOPE=default
WORKSPACE_SCOPE=default
SELF_IMPROVE_DB=./.engram/self_improvement.db
CONNECTOR_READINESS_DB=./.engram/connector_readiness.db

# The ignored private vault is initialized from vault-template.
VAULT_PATH=./prepende-data/default/vault
VAULT_INDEX_PATH=
GRAPHIFY_GRAPH_PATH=./graphify-out/graph.json

# Generic HTTP compatibility surface.
ENGRAM_HTTP_PORT=8088
ENGRAM_API_TOKEN=
PREPENDE_DEFAULT_TENANT=default
PREPENDE_ACCOUNT_EMAIL=
PREPENDE_BRAIN_ID=
PREPENDE_BUSINESS_PROFILES={}

# MCP. Leave identity and scope blank in the reusable template. A launch command
# or bearer token must bind the actual tenant/workspace namespace explicitly.
MCP_HTTP_PORT=8080
PREPENDE_TENANT_TOKENS=
PREPENDE_MCP_SCOPE=
PREPENDE_MCP_TENANT=
PREPENDE_MCP_WORKSPACE=
PREPENDE_MCP_CAPABILITIES=safe
PREPENDE_MCP_TRANSPORT=stdio
PREPENDE_MCP_HOST=127.0.0.1
PREPENDE_MCP_PORT=8765
PREPENDE_DEPLOYMENT_REVISION=
OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=

# Approval-gated workflow/connectors. Configuration does not authorize action.
N8N_WEBHOOK_URL=
N8N_API_KEY=
PREPENDE_WORKFLOWS=

MAX_TOKENS_PER_RUN=200000
MAX_RETRIES=3
MAX_TOOL_CHAIN_DEPTH=8

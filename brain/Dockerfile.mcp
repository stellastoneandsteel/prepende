# Standalone customer-safe Prepende MCP-HTTP image. The source-only release is
# zero-credential and local-first; hosted Postgres/provider configuration is a
# separate, explicitly authorized gate.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONPATH=/app \
    PREPENDE_MCP_TRANSPORT=http \
    PREPENDE_MCP_HOST=0.0.0.0 \
    PREPENDE_MCP_PORT=8765

WORKDIR /app

COPY requirements-prepende.lock ./
RUN python -m pip install \
    --disable-pip-version-check \
    --no-cache-dir \
    --no-input \
    --require-hashes \
    --only-binary=:all: \
    --requirement requirements-prepende.lock

COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/prepende-entrypoint

COPY agents ./agents
COPY connectors ./connectors
COPY interface ./interface
COPY kernel ./kernel
COPY knowledge ./knowledge
COPY memory ./memory
COPY models ./models
COPY prepende ./prepende
COPY prompts ./prompts
COPY routes ./routes
COPY self_improve ./self_improve
COPY services ./services
COPY support ./support
COPY tactics ./tactics
COPY tui ./tui
COPY vault-template ./vault-template
COPY vault-template ./vault
COPY workspace ./workspace
COPY workflows*.json ./

# COPY preserves source permissions, which are not a sufficient customer-state
# contract. The entrypoint repeats this repair for mounted/preexisting state.
RUN find /app/vault -type d -exec chmod 700 {} + \
    && find /app/vault -type f -exec chmod 600 {} + \
    && mkdir -m 700 -p /app/.engram /app/.workspaces /app/prepende-data

EXPOSE 8765

ENTRYPOINT ["prepende-entrypoint"]
CMD ["python", "-m", "interface.mcp_server"]
